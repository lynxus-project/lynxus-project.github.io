---
import '../styles/site.css';

const features = [
  ['Compile-time first', 'SQL, parameters, and result shapes are checked before runtime.'],
  ['Explicit JDBC', 'Generated Mappers call one small executor contract.'],
  ['Spring-ready', 'DataSource domains and transactions stay under Spring ownership.'],
];

const pageTitle = 'Lynxus - Compile-time Java ORM | SQL mapping, made visible.';
const pageDescription = 'Lynxus is a compile-time Java ORM and pragmatic MyBatis alternative. It generates ordinary Mapper implementations at javac and executes them through explicit JDBC, with no runtime XML or OGNL.';
const pageUrl = 'https://lynxus-project.github.io/';
const socialImage = 'https://lynxus-project.github.io/img/lynxus-social-card.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="compile-time Java ORM, MyBatis alternative, compile-time SQL mapper, GraalVM Native Image Java ORM, Spring Boot 4 mapper, zero reflection JDBC Java, Lynxus" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lynxus" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lynxus - Compile-time Java ORM. SQL mapping, made visible." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Lynxus - Compile-time Java ORM. SQL mapping, made visible." />
    <link rel="icon" type="image/svg+xml" href="/img/lynxus-mark.svg" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: 'Lynxus',
      description: pageDescription,
      url: pageUrl,
      image: socialImage,
      codeRepository: 'https://github.com/lynxus-project/lynxus',
      programmingLanguage: 'Java',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      keywords: 'compile-time Java ORM, MyBatis alternative, compile-time SQL mapper, JDBC, Spring Boot 4',
    })} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><img src="/img/lynxus-mark-light.svg" alt="" /> Lynxus</a>
      <nav><a href="/docs">Docs</a><a href="/docs/user/spring/spring-boot">Spring Boot</a><a href="https://github.com/lynxus-project/lynxus" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    </header>
    <main>
      <section class="hero">
        <div class="hero-copy">
          <div class="stack-tags" aria-label="Lynxus technology stack"><span>JAVA</span><i>·</i><span>JDBC</span><i>·</i><span>COMPILE-TIME</span></div>
          <h1>Lynxus</h1>
          <h2 class="hero-title">Compile-time Java ORM.</h2>
          <h3 class="slogan">A pragmatic MyBatis alternative. javac generates ordinary Mapper implementations. No runtime XML. No OGNL.</h3>
          <div class="actions"><a class="button primary" href="/docs/user/getting-started/">Quick Start</a><a class="button ghost" href="https://github.com/lynxus-project/lynxus" target="_blank" rel="noopener noreferrer">View on GitHub</a></div>
        </div>
        <div class="signal-card" aria-label="Lynxus compile-time signal">
          <div class="signal-glow"></div><div class="signal-orbit orbit-one"></div><div class="signal-orbit orbit-two"></div>
          <div class="signal-core"><img src="/img/lynxus-mark-light.svg" alt="Lynxus logo" /><small>Lynxus</small></div>
          <div class="signal-chip chip-top">COMPILE-TIME <b>✓</b></div><div class="signal-chip chip-right">AOT native</div><div class="signal-chip chip-bottom">JDBC lifecycle</div>
          <div class="signal-lines"><span></span><span></span><span></span></div>
        </div>
      </section>
      <section class="features"><p class="eyebrow">A SMALLER SURFACE AREA</p><h2>Make the SQL path obvious.</h2><div class="feature-grid">{features.map(([title, text], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
      <section class="proof"><div><p class="eyebrow">AOT-FIRST BY DESIGN</p><h2>Compile once. Run with visible JDBC.</h2><p>Lynxus is a practical MyBatis alternative for people who write Mapper SQL today. It validates SQL at javac, writes a compile-time mapper index, and generates ordinary Java implementations. Startup loads that index instead of parsing XML or creating JDK proxies. Native Image consumers use the same generated path.</p><a href="/docs/user/architecture/">Read the architecture guide →</a></div></section>
    </main>
    <footer><span class="footer-brand"><img src="/img/lynxus-mark-light.svg" alt="" /> Lynxus</span><span>Apache-2.0 · Built for explicit Java systems · <a href="https://github.com/lynxus-project/lynxus" target="_blank" rel="noopener noreferrer">GitHub</a></span></footer>
  </body>
</html>
